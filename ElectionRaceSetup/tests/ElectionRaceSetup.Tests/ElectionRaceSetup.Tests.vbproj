<Project Sdk="Microsoft.NET.Sdk">

  <!-- Console test runner for the UI-free core (CSV, importer, wire builder, socket client). Run with: dotnet run -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>ElectionRaceSetup.Tests</RootNamespace>
    <OptionStrict>On</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <StartupObject>ElectionRaceSetup.Tests.TestRunner</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="TestRunner.vb" />
    <Compile Include="..\..\src\Models.vb" />
    <Compile Include="..\..\src\CsvParser.vb" />
    <Compile Include="..\..\src\RaceImporter.vb" />
    <Compile Include="..\..\src\WireBuilder.vb" />
    <Compile Include="..\..\src\MosClient.vb" />
    <Compile Include="..\..\src\FeedNode.vb" />
    <Compile Include="..\..\src\FeedModels.vb" />
    <Compile Include="..\..\src\FeedReader.vb" />
    <Compile Include="..\..\src\FeedFetcher.vb" />
    <Compile Include="..\..\src\RaceMatcher.vb" />
    <Compile Include="..\..\src\CrosswalkStore.vb" />
    <Compile Include="..\..\src\ResultsEngine.vb" />
    <Compile Include="..\..\src\MonitorModels.vb" />
    <Compile Include="..\..\src\MonitorReader.vb" />
    <Compile Include="..\..\src\MonitorAdapter.vb" />
    <Compile Include="..\..\src\MonitorClient.vb" />
  </ItemGroup>

</Project>
